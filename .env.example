# Public Monad Testnet configuration
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz/
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadscan.com
NEXT_PUBLIC_MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# Official x402 path used by this hackathon demo
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
PAY_TO_ADDRESS=0xREPLACE_WITH_DISPOSABLE_MERCHANT_ADDRESS
OWNER_ADDRESS=0xREPLACE_WITH_DISPOSABLE_OWNER_ADDRESS
AGENT_ADDRESS=0xREPLACE_WITH_DISPOSABLE_AGENT_ADDRESS
AGENT_BUDGET_REGISTRY_ADDRESS=0xREPLACE_AFTER_DEPLOYMENT

# Disposable Testnet agent only. Never commit the real value.
AGENT_PRIVATE_KEY=0xREPLACE_LOCALLY

# Simple presenter gate for the live spending button. Store only in hosting
# secrets; never hard-code it into the browser bundle.
DEMO_ACCESS_CODE=REPLACE_WITH_PRESENTER_CODE

# Demo policy
DEMO_TOTAL_BUDGET_USDC=0.030
DEMO_PER_CALL_LIMIT_USDC=0.002
